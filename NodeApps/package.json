{
  "name": "node-apps-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch --watch-path=server --watch-path=apps/BeliefQandA/server --watch-path=apps/WorldQandA/server --watch-path=apps/qanda-core/server --watch-path=apps/insight/server --watch-path=apps/notebook/server --watch-path=apps/html-library/server --watch-path=apps/bible/server --watch-path=apps/bible-parallel/server --watch-path=apps/recall-verses/server --watch-path=apps/investment/server server/index.js\" \"vite --host 127.0.0.1 --port 5888 --strictPort\"",
    "build": "vite build",
    "desktop": "npm run build && node server/index.js --production",
    "test": "node --test apps/html-library/server/index.test.js",
    "check:belief-qa": "node apps/BeliefQandA/scripts/validate-brief-answers.mjs",
    "start": "node server/index.js --production"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "9.3.1",
    "@mui/private-theming": "9.3.0",
    "@mui/styled-engine": "9.3.0",
    "@mui/system": "9.3.0",
    "@mui/types": "9.3.0",
    "@mui/utils": "9.3.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.7"
  }
}
